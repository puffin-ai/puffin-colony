# Puffin Colony's settings. Setup copies this file to .colony/colony.toml in your repo and fills in every value.

[project]
name = "myapp"                     # short name: session titles, branch prefixes and worktree names
repo = "owner/myapp"               # the GitHub repo, as owner/name
base = "main"                      # PRs go here; colony never pushes to it
preset = "lean"                    # the rules setup copied: lean, puffin or own
max_builders = 4                   # builders the lead opens on this machine; more join from other computers
worktrees = "~/worktrees"          # where builders and batches make their worktrees
fast_check = "npm test"            # a builder's quick check
checks = "npm run lint && npm run typecheck && npm test"   # the full check a batch runs
web_checks = ""                    # optional: a lighter check for a round that changed no backend_paths file
backend_paths = []                 # optional: folders whose change needs the full checks
generated = []                     # files a build writes, such as "src/generated/*"; a conflict there is rebuilt
regen = ""                         # the command that rebuilds the generated files
check_env_file = ""                # optional local file of KEY=VALUE lines for the checks, never committed
install = "npm ci"                 # run in each new worktree
release = ""                       # optional: the branch `colony release` releases the base into, such as main
deploy_workflow = ""               # optional: the workflow `colony release --after` watches, such as deploy.yml

# One table per Claude Code settings folder. person = "any" shares an account with everyone. A session opens on
# --account, else the first of its person's [people.<person>] accounts with room (the soonest weekly reset first),
# else an account of theirs with no reading, else a last_resort account.
[accounts.main]
config_dir = "~/.claude"
person = "you"

[roles]
lead       = { model = "claude-opus-5-5", effort = "high" }
builder    = { model = "claude-opus-5-5", effort = "medium" }
reviewer   = { model = "claude-opus-5-5", effort = "high" }
walker     = { model = "claude-opus-5-5", effort = "medium" }   # add agent = "<name>" to walk with a subagent
fixer      = { model = "claude-opus-5-5", effort = "medium" }
researcher = { model = "claude-opus-5-5", effort = "high" }     # `colony research`; left out, it takes the builder's
spec       = { model = "claude-opus-5-5", effort = "high" }     # `colony spec`; left out, it takes the builder's

[gate]
rubric = ["bugs", "security and privacy", "tests", "performance", "accessibility"]   # the reviewer's checklist
rules = [".colony/core.md", ".colony/rules/*.md"]   # what the reviewer checks against, plus the repo's CLAUDE.md or AGENTS.md
max_rounds = 5
walk = true                        # walk the changed screens in a browser
walk_paths = []                    # a round that changes none of these skips the walk; empty walks every round

[budget]
provider_dollars = 0               # model spend inside the app's own evals; above 0 only with the person's yes
use_api_key = false                # true lets sessions bill ANTHROPIC_API_KEY instead of the account's subscription

[messages]
lead_digest_minutes = 10           # the lead reads gathered lines this often; urgent, blocked, questions and your lines come at once

[people]
logins = []                        # GitHub logins of the people; a line they post counts as theirs and reaches the lead at once

# Each person's accounts in the order to use them, and the ones used only when none of those has room:
# [people.ana]
# accounts = ["ana-team", "ana"]
# last_resort = ["shared"]

[knowledge]
vault = "knowledge"                # the knowledge vault's folder at the top of the repo
# Each check `colony check-docs` runs is "off", "warn" or "fail"; --strict fails on warn too.
page_types = "fail"                # every page declares a type its .types/ folder defines
links = "fail"                     # every [[link]] and relative link resolves
orphans = "fail"                   # another page links to every page
readme_maps = "fail"               # every folder README links each page and subfolder beside it
code_paths = "fail"                # every repo path a live page names in a code span exists
size_caps = "warn"                 # each type's size cap, the living spec's among them
dated_caps = "fail"                # a cap with a from date holds every page created since that day
copied_text = "fail"               # no paragraph stands on two pages
rule_budget = "fail"               # every rule stays within its budget in characters, 12000 by default
replaced_records = "fail"          # a replaced decision record says so
decision_log = "fail"              # decisions.md is what the decision records generate
rule_budgets = { performance = 16000 }   # the puffin preset's performance.md runs past the default budget

[board]
# number = 3                       # optional: the GitHub Project the cards live on; without it, `colony board init`
                                   # makes "Colony: <name>" and every command finds the board by that title
# title = "Colony: myapp"          # optional: the board's title, which `colony board init` uses and commands find it by

# [cycle]                          # optional: `colony tier`'s limits and the repo's own lines (docs/configuration.md)
# tiny_folders = ["apps/web/"]     # a TINY change's code stays in these; any other non-docs file makes it SMALL
# structure_files = ["src/screens/*.screen.tsx"]   # page files beside app/**/page, layout and route: a new one is
                                   # a FEATURE, a moved or deleted one never TINY, as any file under feature_folders
# risk = { config = ["REVIEW.md"] }   # extra risk paths per kind; a path one starts is never docs
# [[cycle.feature_triggers]]       # a FEATURE line: a file glob, and what an added (or removed) line must find
# why = "a new registry key"
# path = "src/commands/registry.py"
# added = '^\s*"([a-z_]+)"\s*:\s*Entry\('

[limits]                           # the anti-bloat limits `colony card new` and `colony tidy` keep
open_cards_per_lead = 10           # `colony card new` refuses a lead past this many open cards
stale_days = 7                     # `colony tidy` closes, or moves to future-work, a card with no update this long
issue_comments = 200               # the coordination and Needs issues rotate at this many comments
archive_days = 7                   # `colony tidy` archives a board item Done this long
