# Puffin Colony's settings. Setup copies this file to .colony/colony.toml in your repo and fills in every value.

[project]
name = "myapp"                     # short name: session titles, branch prefixes and worktree names
repo = "owner/myapp"               # the GitHub repo, as owner/name
base = "main"                      # PRs go here; colony never pushes to it
preset = "lean"                    # the rules setup copied: lean, puffin or own
max_builders = 4                   # builders the lead opens on this machine; more join from other computers
worktrees = ".worktrees"           # where every worktree goes: inside the repo, from its main checkout, kept out of
                                   # git status; a folder outside the repo scatters worktrees and gets a daily note
fast_check = "npm test"            # a builder's quick check, which `colony fast-check` runs; with [checks] areas,
                                   # {areas} in it takes the areas the builder's branch changes
checks = "npm run lint && npm run typecheck && npm test"   # the full check a batch runs; with [checks] areas,
                                   # {areas} in it takes the names of the areas a round runs
backend_paths = []                 # optional: folders whose change is never TINY to `colony tier`
generated = []                     # files a build writes, such as "src/generated/*"; a conflict there is rebuilt
regen = ""                         # the command that rebuilds the generated files
check_env_file = ""                # optional local file of KEY=VALUE lines for the checks, never committed
install = "npm ci"                 # run in each new worktree
release = ""                       # optional: the branch `colony release` releases the base into, such as main
deploy_workflow = ""               # optional: the workflow `colony release --after` watches, such as deploy.yml

# One table per Claude Code settings folder. person = "any" shares an account with everyone. A session opens on
# --account, else the first of its person's [people.<person>] accounts with room (the soonest weekly reset first),
# else an account of theirs with no reading, else a last_resort account.
[accounts.main]
config_dir = "~/.claude"
person = "you"

[roles]
lead       = { model = "claude-opus-5-5", effort = "high" }
builder    = { model = "claude-opus-5-5", effort = "medium" }
reviewer   = { model = "claude-opus-5-5", effort = "high" }
walker     = { model = "claude-opus-5-5", effort = "medium" }   # add agent = "<name>" to walk with a subagent
fixer      = { model = "claude-opus-5-5", effort = "medium" }
researcher = { model = "claude-opus-5-5", effort = "high" }     # `colony research`; left out, it takes the builder's
spec       = { model = "claude-opus-5-5", effort = "high" }     # `colony spec`; left out, it takes the builder's
tester     = { model = "claude-opus-5-5", effort = "high" }     # `colony tester`; left out, it takes the builder's

[gate]
rubric = ["bugs", "security and privacy", "tests", "performance", "accessibility"]   # the reviewer's checklist
rules = [".colony/core.md", ".colony/rules/*.md"]   # what the reviewer checks against, plus the repo's CLAUDE.md or AGENTS.md
max_rounds = 3                     # 3 at most: after the last, each open finding becomes a card the PR lists
walk = true                        # walk the changed screens in a browser
walk_paths = []                    # a round that changes none of these skips the walk; empty walks every round

# Optional: check only the areas a change touches. Each area names its paths, a prefix or a glob; a changed path no
# area names runs every area, and one under skip runs none. Put {areas} in [project] checks, such as
# checks = "python3 tools/checks.py {areas}"; all is the word it takes when every area runs.
[checks]
areas = {}                         # such as { web = ["apps/web/"], backend = ["apps/backend/"] }
all = ""                           # such as "all"; empty joins every area's name
skip = []                          # such as ["docs/", "*.md"]
rerun = ""                         # a failing test whose output names a timeout or time limit runs once more alone
                                   # with this, {test} its id, such as "cd apps/backend && uv run pytest {test}"
minutes = 0                        # a full check run's minutes, the yardstick for the minutes minutes.md says it saved
# Proportional checks (docs/checks.md): the tests for a change and the guard tests, a time budget for each kind of
# check, and a pass on the same code reused instead of run again.
related = ""                       # the command that runs a change's tests, such as "uv run pytest {tests}"; once set,
                                   # "related" is the default scope
guards = []                        # tests that run with every related check, such as ["tests/test_architecture.py"]
# scope = "related"                # "related", "areas" (the default without related) or "full", the full suite
# tests = { "setup.cfg" = ["tests/"] }   # the tests of files whose tests aren't named after them
budgets = { fast = 300, checks = 300, full = 0 }   # seconds a command follows a check before it leaves it running
                                   # in the background; 0 sends it there at once
# caps = { full = 3600 }           # a run past its cap, in seconds, is stopped and counts as failed
# reuse = true                     # reuse a pass on the same code with the same command
# locks = ["test-db"]              # locks every check run holds besides tests, such as one shared test database;
                                   # [locks.<name>] slots sets how many runs share it

# [ci]                             # `colony ci`: start CI on any commit, watch it live, post the result
# start = ""                       # the command that starts CI, with {sha}, {short}, {branch} and {repo}; empty pushes
                                   # the commit to a branch of its own, colony-ci/{short}
# post = true                      # post the result on the commit's pull request, else on the commit
# cancel_superseded = true         # cancel the runs on older commits of the same branch

[walk]
browser = "playwright"             # "playwright" (the Playwright MCP) or "agent-browser" (the agent-browser CLI)
screens = {}                       # each screen and the paths that feed it, such as { "/calendar" = ["src/calendar/"] }
minutes = 0                        # a full walk's minutes and dollars, the yardstick for what a skip saved
cost = 0

[budget]
provider_dollars = 0               # model spend inside the app's own evals; above 0 only with the person's yes
use_api_key = false                # true lets sessions bill ANTHROPIC_API_KEY instead of the account's subscription

[messages]
lead_digest_minutes = 10           # the lead reads gathered lines this often; urgent, blocked, questions and your lines come at once
# max_line = 300                   # the most characters in a line's sentence; a longer note goes with --attach <file>
# start_ack_minutes = 10           # a start line goes again when the helper's wait hasn't acknowledged it by then; 0 for none
# start_resends = 2                # sends of an unacknowledged start line before the lead hears it at once
# nudge = "off"                    # "auto" types a pointer into an idle recipient's cmux workspace on this computer; or "always"
# redeliver_minutes = 60           # after a compaction or restart, show the unacknowledged lines from this far back
# check_names = true               # refuse a line for a name no session has
# refuse_local_paths = true        # refuse a line naming a path on this computer, which other computers can't read

[people]
logins = []                        # GitHub logins of the people; a line they post counts as theirs and reaches the lead at once

# Each person's accounts in the order to use them, and the ones used only when none of those has room:
# [people.ana]
# accounts = ["ana-team", "ana"]
# last_resort = ["shared"]
# quiet_lead = true               # the lead acts on notifications silently, and writes to ana only to converse or
                                   # when ana must act; false by default, which keeps the person posted on progress

[knowledge]
vault = "knowledge"                # the knowledge vault's folder at the top of the repo
# future_work = "knowledge/future-work.md"   # `colony idea`'s register; a table under its ## Ideas gets a row
# Each check `colony check-docs` runs is "off", "warn" or "fail"; --strict fails on warn too.
page_types = "fail"                # every page declares a type its .types/ folder defines
links = "fail"                     # every [[link]] and relative link resolves
orphans = "fail"                   # another page links to every page
readme_maps = "fail"               # every folder README links each page and subfolder beside it
code_paths = "fail"                # every repo path a live page names in a code span exists
size_caps = "warn"                 # each type's size cap, the living spec's among them
dated_caps = "fail"                # a cap with a from date holds every page created since that day
copied_text = "fail"               # no paragraph stands on two pages
rule_budget = "fail"               # every rule stays within its budget in characters, 12000 by default
replaced_records = "fail"          # a replaced decision record says so
decision_log = "fail"              # decisions.md is what the decision records generate
rule_budgets = { performance = 16000 }   # the puffin preset's performance.md runs past the default budget

[board]
# number = 3                       # optional: the GitHub Project the cards live on; without it, `colony board init`
                                   # makes "Colony: <name>" and every command finds the board by that title
# title = "Colony: myapp"          # optional: the board's title, which `colony board init` uses and commands find it by

# [cycle]                          # optional: `colony tier`'s limits and the repo's own lines (docs/configuration.md)
# tiny_folders = ["apps/web/"]     # a TINY change's code stays in these; any other non-docs file makes it SMALL
# structure_files = ["src/screens/*.screen.tsx"]   # page files beside app/**/page, layout and route: a new one is
                                   # a FEATURE, a moved or deleted one never TINY, as any file under feature_folders
# risk = { config = ["REVIEW.md"] }   # extra risk paths per kind; a path one starts is never docs
# [[cycle.feature_triggers]]       # a FEATURE line: a file glob, and what an added (or removed) line must find
# why = "a new registry key"
# path = "src/commands/registry.py"
# added = '^\s*"([a-z_]+)"\s*:\s*Entry\('

[limits]                           # the anti-bloat limits `colony card new` and `colony tidy` keep
open_cards_per_lead = 10           # `colony card new` refuses a lead past this many open cards
stale_days = 7                     # `colony tidy` closes, or moves to future-work, a card with no update this long
issue_comments = 200               # the coordination and Needs issues rotate at this many comments
archive_days = 7                   # `colony tidy` archives a board item Done this long

# Folders (docs/folders.md): when a lead counts as silent, and when a gone lead drops from the registry.
# [leads]
# silent_minutes = 120             # a lead whose own session did nothing this long: its folders can be borrowed
# drop_after_hours = 72            # a lead gone this long drops from the registry, and `colony who` stops listing it
#
# This computer's own settings go in .colony/colony.local.toml, over this file, which git never tracks:
# `colony config local` makes it (docs/configuration.md#layers).

# Capacity (docs/capacity.md): every table below is optional, and each key shown holds its default.
# [pool]                           # the team's rules for its pool of accounts
# order = "reset"                  # "reset": the soonest weekly reset first; "listed": the person's own order
# out_at = 95                      # a window at or past this percent has no room: a new session switches account
# near_at = 80                     # a 5-hour window this full, with its reset over near_hours off, is skipped too
# near_hours = 1
# reserve = []                     # accounts kept free: used only when named with --account
# max_busy = 3                     # helpers one account runs at once; an account's own max_busy overrides it
# wave = 3                         # helpers `colony helpers <n> --open` opens at once; the rest in later waves
# wave_seconds = 60                # the pause between waves
# stale_minutes = 15               # a usage reading older than this never places a session (at least 10)
# share_lead_accounts = false      # false: helpers use a live lead's own account only when no other has room,
                                   # one fewer than its cap; true: as any other account
# helper_rate = 10                 # 5-hour percent one helper uses an hour, a guess until readings show the rate
# scan_folders = ["~/.claude", "~/.claude-*", "~/.claude_*"]  # where `colony accounts scan` looks
#
# [subagents]                      # the subagent guard: builders run as helpers, never as subagents
# max_running = 2                  # the most subagents one session runs at once; 0 lets none run
#
# [machine]                        # what one helper, test run and build needs here; Colony reads the rest itself
# helper_gb = 1                    # memory one helper session needs
# test_gb = 2                      # memory one test run needs; build_gb the same for a build
# test_cores = 2                   # cores one test run keeps busy; build_cores the same for a build
# keep_free_gb = 2                 # memory left for you and the system
# keep_free_disk_gb = 10           # below this much free disk, the computer counts as busy
# busy_load = 1                    # at or past this load per core, it is busy: no new helper opens here
#
# [services.aws]                   # a check for a service the team relies on; accounts and gh are checked already
# check = "aws sts get-caller-identity"
# fix = "aws sso login"            # what you do when it fails; expect, at_least, at_most and exit set the pass
#
# [locks.test-db]                  # a lock for a thing one run at a time may use: `colony lock test-db -- <command>`
# slots = 1

[safety]                           # what the merge guard lets agents land (docs/safety.md#the-merge-guard)
merge_into = []                    # branches agents may merge pull requests into, such as ["dev"]; empty, they
                                   # open pull requests for you; counts once on GitHub's default branch
protect = []                       # more branches to protect beside the base and the default branch, such as ["staging"]

[recover]                          # what `colony crash-report` and `colony resume` look at (docs/safety.md#recovery)
within_hours = 24                  # how far back both look for sessions that showed life
# [services.db]                    # a local service your work needs: its check, and the command that starts it again
# check = "pg_isready -h localhost -p 5432"
# restart = "docker compose up -d db"

# Watch (docs/watch.md): optional, and each key shown holds its default.
# [watch]
# idle_minutes = 20                # a session doing nothing this long, with no reason given, is idle
# report_minutes = 30              # a working helper reports at least this often: `colony report "<progress>"`
# agent_minutes = 45               # how long a helper's own helper agent may run
# intent_hours = 4                 # a wait or hold with no end time is checked after this long
# late_after = 1                   # a card past this many times its prediction is late
# every_minutes = 2                # how often the lead's wait and the watchdog look at the team
# page = true                      # the watchdog keeps the status page, the pinned `Colony: status` issue
# page_minutes = 5                 # how often the status page may change
# watchdog = true                  # the lead's wait starts the watchdog when none runs on its computer
# escalate_minutes = 60            # a lead idle this long past idle_minutes has its person mentioned on GitHub
# quit_hours = 24                  # a watchdog started by a wait ends after this long with no session alive here
